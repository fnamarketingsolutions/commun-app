<resources>
  <!-- Splash theme – used during app launch (no app icon, just a solid background) -->
  <style name="SplashTheme" parent="Theme.AppCompat.Light.NoActionBar">
    <item name="android:windowBackground">@color/splash_background</item>
  </style>

  <!-- Main app theme – used after the splash screen is hidden -->
  <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
    <!-- Add any custom styles here (e.g., status bar color, etc.) -->
    <item name="android:windowBackground">@color/splash_background</item>
  </style>
</resources>